# Review Radar — environment variables (copy to .env for local dev; never commit .env)
# config.py reads these via os.environ after load_dotenv().

# Your Anthropic API key. Required only when FAKE_LLM is off (real Claude calls).
ANTHROPIC_API_KEY=

# Which Claude model to use. Defaults to Claude Haiku in config.py if unset.
MODEL=claude-haiku-4-5-20251001

# Offline mode: set to 1 to return canned analysis with no API key / no network.
# Leave unset or 0 to call the real Claude API.
FAKE_LLM=1
