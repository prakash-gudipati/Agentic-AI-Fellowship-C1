# Session 38 — copy this file to .env and fill in your keys.
# cp .env.example .env

# REQUIRED — this session runs against the real Anthropic API.
ANTHROPIC_API_KEY=sk-ant-...

# RECOMMENDED — Tavily is the LLM-friendly search engine (free tier available
# at tavily.com). If this is absent, the workflow falls back to keyless
# DuckDuckGo search automatically — so you can run the demo with no Tavily key.
TAVILY_API_KEY=tvly-...

# OPTIONAL — override the model (defaults to Claude Haiku 4.5).
# S38_MODEL=claude-haiku-4-5-20251001

# OPTIONAL — keep stale bytecode off a mounted/networked filesystem.
# PYTHONPYCACHEPREFIX=/tmp/s38_pycache
