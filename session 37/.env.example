# Session 37 — environment variables
#
# Copy this file to `.env` and fill in your real key. `.env` is gitignored.

# REQUIRED for real-mode demos. Skip if you only run FAKE_LLM=1.
ANTHROPIC_API_KEY=sk-ant-replace-me

# OPTIONAL. Set to 1 to skip the API entirely and run the deterministic
# offline routes. Useful for CI smoke tests and classrooms without internet.
# FAKE_LLM=1

# OPTIONAL (Phase 5 build convention). Redirect new .pyc writes off a
# mounted filesystem so file edits actually take effect.
# PYTHONPYCACHEPREFIX=/tmp/s37_pycache

# OPTIONAL. Disable ANSI colour in the trace output.
# NO_COLOR=1
