# Session 41 — Fine-Tuning Fundamentals
# Copy to .env and fill in real values

# Required for real API calls (not needed for FAKE_LLM=1 mode)
OPENAI_API_KEY=sk-

# PROD PATTERN: Model ID from env var — never hardcode
FT_MODEL_ID=ft:gpt-4o-mini-2024-07-18:your-org:your-task:abc123

# Optional overrides
FT_BASE_MODEL=gpt-4o-mini-2024-07-18   # model to fine-tune
FT_N_EPOCHS=3                           # reduce to 1 if val_loss diverges
FT_CONFIG_PATH=ft_config.json           # where to store job metadata
FT_VERSION_FILE=ft_versions.json        # version registry
DATASET_DIR=.                           # where to write JSONL files
EVAL_GATE_THRESHOLD=0.75                # minimum fine-tuned model accuracy
EVAL_DATA_PATH=eval_data.jsonl          # held-out eval set

# Offline smoke-test (no API calls)
# FAKE_LLM=1
# PYTHONPYCACHEPREFIX=/tmp/s41_pycache
