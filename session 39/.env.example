# Session 39 — copy this file to .env and fill in your keys.
# cp .env.example .env

# REQUIRED for a real run — this session runs against the real Anthropic API.
# (Leave blank and set FAKE_LLM=1 to run every demo offline with canned replies.)
ANTHROPIC_API_KEY=sk-ant-...

# RECOMMENDED — Tavily is the LLM-friendly search engine (free tier at tavily.com).
# If absent, the workflow falls back to keyless DuckDuckGo automatically.
TAVILY_API_KEY=tvly-...

# OFFLINE MODE — set to 1 to run all demos with no key and no network.
# FAKE_LLM=1

# OPTIONAL — where the durable checkpoint database lives. Move it off a
# networked / FUSE mount if SQLite complains about file locking.
# S39_DB_PATH=/tmp/s39_research_agent.db

# OPTIONAL — override the model (defaults to Claude Haiku 4.5).
# S39_MODEL=claude-haiku-4-5-20251001

# OPTIONAL — keep stale bytecode off a mounted/networked filesystem.
# PYTHONPYCACHEPREFIX=/tmp/s39_pycache
