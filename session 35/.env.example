# Session 35 — Multi-Agent Systems II
#
# Required (one or the other):
ANTHROPIC_API_KEY=your-key-here
# OR set FAKE_LLM=1 to run all 5 demos offline (no key needed).
FAKE_LLM=0

# Recommended on mounted / networked / FUSE filesystems where Python
# cannot delete __pycache__/ entries. Without this, stale bytecode can
# survive source edits and burn 10+ minutes of debugging time.
# PYTHONPYCACHEPREFIX=/tmp/s35_pycache
# PYTHONDONTWRITEBYTECODE=1

# Disable ANSI colour in the trace if piping to a file.
# NO_COLOR=1
