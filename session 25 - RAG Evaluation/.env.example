# Copy this file to .env and fill in your keys.
# .env is git-ignored — your real keys never leave your machine.

# Used by both the answer LLM (Anthropic) and the LLM-as-judge metrics
# inside the offline-fallback Ragas judge path.
ANTHROPIC_API_KEY=sk-ant-...

# Used by the embedding model (text-embedding-3-small from OpenAI).
OPENAI_API_KEY=sk-...
