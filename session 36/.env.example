# Session 36 — environment variables
# Copy to .env and fill in. Every demo runs WITHOUT a key if FAKE_LLM=1.

# Real agent brain (only needed when FAKE_LLM is not 1):
# ANTHROPIC_API_KEY=sk-ant-...

# Offline agent brain — deterministic, no key, no network:
FAKE_LLM=1

# Phase 5 build rule — redirect bytecode off mounted/networked filesystems:
# PYTHONPYCACHEPREFIX=/tmp/s36_pycache

# Sandbox dir for read_file / write_file (defaults to ./workspace):
# S36_WORKSPACE_DIR=/tmp/s36_workspace
