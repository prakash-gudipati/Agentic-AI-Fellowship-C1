# Session XX — environment variables
#
# Copy this file to `.env` (no extension) and fill in your real keys.
# `.env` is in `.gitignore` so the secrets never leave your machine.

# REQUIRED for real-mode demos. Skip if you only run FAKE_LLM=1.
ANTHROPIC_API_KEY=sk-ant-replace-me

# OPTIONAL. Set to 1 to skip the API entirely and run the canned offline
# routes. Useful for CI smoke tests and for classrooms without internet.
# FAKE_LLM=1

# OPTIONAL (Phase 5 build convention). Redirect new .pyc writes off the
# mounted filesystem so file edits actually take effect. Used by the
# smoke-test commands the instructor runs pre-class.
# PYTHONPYCACHEPREFIX=/tmp/sXX_pycache

# OPTIONAL (only if this session uses ChromaDB). Override the Chroma
# persistence directory to a local path so SQLite can lock files
# correctly on FUSE / network mounts.
# SXX_CHROMA_DIR=/tmp/sXX_chroma

# OPTIONAL (only if this session uses sentence-transformers). Set to 1
# to use real embeddings instead of the offline hash embedder.
# USE_REAL_EMBEDDINGS=1
